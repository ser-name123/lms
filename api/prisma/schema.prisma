  timeEnd   String
  link      String?
  host      String
  status    String   @default("Upcoming")
  agenda    String?
  // Array of { name, role, email, status } — stored as JSON.
  attendees Json     @default("[]")
  createdAt DateTime @default(now())
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PayoutMethod {
  BANK_TRANSFER
  WISE
  PAYPAL
  CASH
  STRIPE
}

model Payout {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount             Decimal      @db.Decimal(10, 2)
  deductions         Decimal      @default(0) @db.Decimal(10, 2)
  bonus              Decimal      @default(0) @db.Decimal(10, 2)
  netAmount          Decimal      @db.Decimal(10, 2)
  /*
   * What the teacher is paid in. Every other money row in the system names its
   * currency; a payslip did not, so it was read as dollars wherever it was
   * shown, whichever country the teacher is in.
   */
  currency           String       @default("USD")
  paymentMethod      PayoutMethod @default(BANK_TRANSFER)
  status             PayoutStatus @default(PENDING)
  paymentDate        DateTime?
  referenceNumber    String?
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // ── Finance & Reporting: payslip breakdown ──
  payslipNo     String?  @unique // PSL-2026-000001 (set when a payslip is issued)
  payrollModel  String?          // FIXED / PER_CLASS / PER_HOUR / PER_STUDENT / HYBRID
  classesCount  Int?
  hoursCount    Float?
  studentsCount Int?

  @@index([userId])
  @@index([status])
}

// ─── Teacher Earnings & Salary (Modules 6A / 6B / 6C / 6D) ───────────────────
// Self-contained per-class earnings ledger + monthly salary consolidation, kept
// separate from the legacy Payout/PayrollConfig batch payroll so neither breaks.
// Soft FKs (plain id columns, no relations) matching the app convention.

enum EarningClassType {
  REGULAR
  TRIAL
  TRIAL_ENROLL_BONUS
}

// How attendance resolved for the class the earning is derived from (spec 6A).
enum EarningAttendanceOutcome {
  COMPLETED        // student + teacher present → paid
  STUDENT_NO_SHOW  // teacher present, student absent → paid
  TEACHER_ABSENT   // teacher absent → NOT paid, earnings 0
  BOTH_NO_SHOW     // both absent → NOT paid, student marked absent
}

model TeacherEarning {
  id               String                   @id @default(uuid())
  teacherId        String                   // TeacherProfile.id
  classSessionId   String?                  @unique // one earning per regular class (idempotency)
  leadTrialId      String?                  // trial the earning derives from (payout + optional enrol bonus)
  studentId        String?                  // StudentProfile.id
  courseId         String?
  classType        EarningClassType         @default(REGULAR)
  scheduledMinutes Int                      @default(0)
  hourlyRate       Decimal                  @default(0) @db.Decimal(10, 2)
  amount           Decimal                  @default(0) @db.Decimal(10, 2)
  currency         String                   @default("USD")
  outcome          EarningAttendanceOutcome
  paid             Boolean                  @default(false) // did the teacher earn (false when absent)
  salaryId         String?                  // consolidated into which TeacherSalary
  earnedAt         DateTime                 @default(now())
  createdAt        DateTime                 @default(now())

  // One TRIAL payout and one TRIAL_ENROLL_BONUS may both reference a trial, but
  // neither may duplicate. NULLs (regular classes) are distinct in Postgres.
  @@unique([leadTrialId, classType])
  @@index([teacherId, earnedAt])
  @@index([salaryId])
  @@index([teacherId, paid])
}

enum TeacherAbsenceStatus {
  PENDING
  RESCHEDULED
  DISMISSED
}

// Teacher-absent classes (spec 6A scenario 3): a task list the Academic Coach
// works through to reschedule the missed class.
model TeacherAbsenceTask {
  id                   String               @id @default(uuid())
  classSessionId       String               @unique
  teacherId            String
  studentId            String?
  courseId             String?
  originalStartsAt     DateTime
  status               TeacherAbsenceStatus @default(PENDING)
  rescheduledSessionId String?
  resolvedById         String?
  resolvedByName       String?
  resolvedAt           DateTime?
  createdAt            DateTime             @default(now())

  @@index([status])
  @@index([teacherId, status])
}

enum SalaryStatus {
  CALCULATED
  UNDER_REVIEW
  ADJUSTMENT_APPLIED
  APPROVED
  // Claimed by a pay attempt that has not come back yet. This exists so the
  // claim can be atomic: `pay()` flips APPROVED/FAILED → PROCESSING with a
  // conditional update BEFORE calling Wise, so a double-click or a retry cannot
  // put through two transfers. A row left stranded here means the transfer was
  // sent and we never learned the outcome — which is a human's job to reconcile
  // against Wise, not something to retry blindly.
  PROCESSING
  PAID
  FAILED
}

model TeacherSalary {
  id               String       @id @default(uuid())
  teacherId        String       // TeacherProfile.id
  periodStart      DateTime
  periodEnd        DateTime
  monthLabel       String       // "June 2026"
  totalClasses     Int          @default(0)
  trialEarnings    Decimal      @default(0) @db.Decimal(10, 2)
  regularEarnings  Decimal      @default(0) @db.Decimal(10, 2)
  bonusEarnings    Decimal      @default(0) @db.Decimal(10, 2)
  grossAmount      Decimal      @default(0) @db.Decimal(10, 2)
  adjustmentsTotal Decimal      @default(0) @db.Decimal(10, 2)
  netAmount        Decimal      @default(0) @db.Decimal(10, 2)
  currency         String       @default("USD")
  status           SalaryStatus @default(CALCULATED)
  approvedById     String?
  approvedByName   String?
  approvedAt       DateTime?
  // Payment (Wise) outcome mirrored onto the salary for quick display.
  paidAt           DateTime?
  wiseReference    String?
  failureReason    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([teacherId, periodStart])
  @@index([status])
  @@index([periodStart])
}

enum SalaryAdjustmentType {
  EXTRA_PAY
  DEDUCTION
}

// Itemised salary adjustment (spec 6B step 4) — each with its own reason, audited.
model SalaryAdjustment {
  id           String               @id @default(uuid())
  salaryId     String
  type         SalaryAdjustmentType
  amount       Decimal              @db.Decimal(10, 2)
  reason       String
  createdById  String?
  createdByName String?
  createdAt    DateTime             @default(now())

  @@index([salaryId])
}

enum SalaryPaymentStatus {
  SUCCESS
  FAILED
}

// Every Wise payment attempt (spec 6C step 5 payment history) — retries append.
model SalaryPayment {
  id              String              @id @default(uuid())
  salaryId        String
  teacherId       String
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("USD")
  reference       String?             // Wise transaction reference
  status          SalaryPaymentStatus
  failureReason   String?
  attemptedById   String?
  attemptedByName String?
  attemptedAt     DateTime            @default(now())

  @@index([salaryId])
  @@index([teacherId])
}

enum MonthlyReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// Teacher's monthly progress report per student (spec 6D): teacher submits →
// supervisor + admin review → supervisor approves → salary cycle can finalise.
model TeacherMonthlyReport {
  id             String              @id @default(uuid())
  teacherId      String              // TeacherProfile.id
  studentId      String              // StudentProfile.id
  periodStart    DateTime
  periodEnd      DateTime
  monthLabel     String
  summary        String?
  strengths      String?
  areasToImprove String?
  recommendation String?
  attendanceNote String?
  status         MonthlyReportStatus @default(DRAFT)
  submittedAt    DateTime?
  supervisorReviewedById   String?
  supervisorReviewedByName String?
  supervisorReviewedAt     DateTime?
  adminReviewedById        String?
  adminReviewedByName      String?
  adminReviewedAt          DateTime?
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?
  reviewNotes    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([teacherId, studentId, periodStart])
  @@index([teacherId, periodStart])
  @@index([status])
}

model ExpenseCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  expenses  Expense[]
  createdAt DateTime  @default(now())
}

enum ExpenseStatus {
  APPROVED
  PENDING
  REJECTED
}

enum ExpensePaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  PAYPAL
  CASH
  WISE
}

model Expense {
  id            String               @id @default(uuid())
  title         String
  amount        Decimal              @db.Decimal(10, 2)
  categoryId    String
  category      ExpenseCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  paymentMethod ExpensePaymentMethod @default(BANK_TRANSFER)
  status        ExpenseStatus        @default(PENDING)
  paymentDate   DateTime             @default(now())
  merchant      String?
  referenceNo   String?
  receiptUrl    String?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([categoryId])
  @@index([status])
}

model ChatMessage {
  id         String   @id @default(uuid())
  studentId  String?
  teacherId  String?
  senderRole String   // "STUDENT", "TEACHER", or "ADMIN"
  senderName String
  content    String
  createdAt  DateTime @default(now())

  student    StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher    TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

// ─── Public student self-registration ────────────────────────────────────────

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
}

// A prospective student's self-submitted application. Sits in PENDING until an
// admin reviews it; on approval a real User + StudentProfile is created and the
// generated identifiers below are filled in.
model StudentRegistration {
  id             String             @id @default(uuid())
  registrantType String             @default("STUDENT") // "STUDENT" or "PARENT"

  // Basic details
  firstName      String
  middleName     String?
  lastName       String
  gender         String?
  dateOfBirth    DateTime?
  nationality    String?
  country        String?
  state          String?
  city           String?
  address        String?

  // Contact details
  studentEmail   String
  studentMobile  String?
  parentEmail    String?
  parentMobile   String?
  emergencyContact String?
  whatsappNumber String?

  // Education details
  currentSchool  String?
  board          String?
  className      String?
  grade          String?
  subjects       String?
  language       String?

  // Course selection + learning mode
  courseCode     String?  // references LmsCourse.code
  courseTitle    String?
  batch          String?  // Morning / Evening / Weekend
  preferredTiming String?
  learningMode   String?  // ONLINE / OFFLINE / HYBRID

  // Guardian details
  fatherName      String?
  motherName      String?
  occupation      String?
  guardianRelation String?
  guardianAddress String?
  guardianEmail   String?
  guardianPhone   String?

  // Account credentials chosen by the applicant
  username       String?
  passwordHash   String

  // Review workflow
  status         RegistrationStatus @default(PENDING)
  reviewNotes    String?
  reviewedAt     DateTime?
  reviewedById   String?

  // Filled in on approval
  studentProfileId String?
  admissionNumber  String?
  rollNumber       String?
  approvedStudentCode String?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
}

// ─── Public teacher self-registration ────────────────────────────────────────

// The teacher hiring pipeline. An application walks through these stages; the
// admin advances it stage-by-stage. ACTIVATED is the terminal success state and
// triggers creation of a real User + TeacherProfile with a generated code.
enum TeacherRegistrationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  DEMO_CLASS
  APPROVAL
  TRAINING
  ACTIVATED
  REJECTED
  NEEDS_INFO
}

model TeacherRegistration {
  id             String                    @id @default(uuid())

  // Personal information
  firstName      String
  middleName     String?
  lastName       String
  gender         String?
  dateOfBirth    DateTime?
  nationality    String?
  country        String?
  state          String?
  city           String?
  address        String?

  // Contact
  email          String
  mobile         String?
  whatsappNumber String?

  // Professional details
  highestQualification String?
  university           String?
  passingYear          String?
  experienceYears      String?
  currentEmployer      String?
  expectedSalary       String?
  subjects             String?  // comma-separated subjects taught
  languages            String?  // comma-separated languages
  teachingMode         String?  // ONLINE / OFFLINE / HYBRID

  // Availability (Mon..Sun days + Morning/Afternoon/Evening slots)
  availabilityDays  String[] @default([])
  availabilitySlots String[] @default([])

  // Technical skills (Zoom, Google Meet, Teams, Whiteboard, LMS, ...)
  technicalSkills   String[] @default([])

  // Bank / payout details
  accountNumber  String?
  ifsc           String?
  bankName       String?
  upi            String?
  taxNumber      String?

  // Documents (relative /uploads paths, filled via the upload endpoint)
  resumeUrl             String?
  degreeUrl             String?
  certificatesUrl       String?
  govIdUrl              String?
  photoUrl              String?
  experienceLetterUrl   String?
  policeVerificationUrl String?

  // Account credentials chosen by the applicant
  username       String?
  passwordHash   String

  // Hiring pipeline
  status         TeacherRegistrationStatus @default(APPLIED)
  reviewNotes    String?
  interviewDate  DateTime?
  interviewNotes String?
  demoDate       DateTime?
  demoNotes      String?
  reviewedAt     DateTime?
  reviewedById   String?

  // Filled in on activation. The relation is SetNull on purpose: when the
  // teacher account is deleted the link must drop itself, otherwise this row
  // keeps claiming an ACTIVATED teacher that no longer exists. An ACTIVATED
  // row with a null link is therefore an archived hire, not a live one.
  teacherProfileId    String?
  teacherProfile      TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: SetNull)
  approvedTeacherCode String?

  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status])
}

// ─── Lead management (website inquiry → evaluation → trial → conversion) ──────

enum LeadStatus {
  NEW
  CONTACT_PENDING
  CONTACTED
  EVALUATION_SCHEDULED
  EVALUATION_COMPLETED
  TEACHER_ASSIGNED
  TRIAL_SCHEDULED
  TRIAL_COMPLETED
  WAITING_PARENT_DECISION
  CONVERTED
  REJECTED
  CLOSED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Lifecycle of a single trial (demo) class booked for a lead.
enum LeadTrialStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

// A prospective-student inquiry captured from the public website lead form.
// Walks the sales/academic pipeline via LeadStatus until CONVERTED (a real
// StudentProfile is created, mirroring the registration approval flow) or
// REJECTED/CLOSED.
model Lead {
  id           String       @id @default(uuid())
  leadNumber   String       @unique // e.g. LD-2026-000001

  // Section 1 — Student details
  studentFirstName String
  studentLastName  String
  gender           String?
  dateOfBirth      DateTime?
  currentGrade     String?
  currentSchool    String?
  country          String?
  timeZone         String?

  // Section 2 — Parent details
  parentName     String?
  relationship   String?
  email          String
  mobile         String
  whatsappNumber String?

  // Section 3 — Learning requirements
  // `interestedSubject` doubles as "What would you like to learn?"
  // (Quran / Arabic Language / Islamic Studies).
  interestedSubject     String?
  currentLevel          String?  // Beginner / Intermediate / Advanced
  preferredLanguage     String?
  preferredTeacherGender String? // Male / Female / Either
  // Superseded by preferredDate + preferredSlot. Kept because leads booked
  // under the old form still carry them and the detail page still reads them.
  preferredDays         String[] @default([])
  preferredTimeSlots    String[] @default([])

  // The visitor picks one concrete date and one 30-minute slot, chosen from
  // merged teacher availability rather than typing a free-text preference.
  preferredDate DateTime?
  preferredSlot String?   // "HH:mm" in preferredSlotTz
  preferredSlotTz String? // IANA zone the slot was displayed in

  sessionFor String? // MYSELF / FAMILY_MEMBER
  howFound   String? // FRIEND / SOCIAL_MEDIA / EMAIL / GOOGLE / OTHER

  // Dial code kept apart from `mobile` so the number stays comparable across
  // countries — "+91 98765" and "98765" are the same person.
  countryCode String?

  // Extra children on the same booking: [{ firstName, lastName }].
  // They share this lead's slot; conversion creates one Student account each.
  siblings Json?

  // Section 4 — Additional questions
  learningGoal        String?
  previousCoaching    String?
  specialRequirements String?
  medicalDisability   String?

  // Section 5 — Security / consent
  acceptPrivacy  Boolean @default(false)
  acceptTerms    Boolean @default(false)
  recaptchaToken String? // captured but not verified yet (stub)

  // Step 3 — Marketing / tracking (very useful for the marketing team)
  leadSource  String  @default("Website")
  ipAddress   String?
  browser     String?
  device      String?
  referralUrl String?
  utmSource   String?
  utmCampaign String?
  utmMedium   String?

  // Pipeline
  status   LeadStatus   @default(NEW)
  priority LeadPriority @default(MEDIUM)

  // Assignment (plain ids, resolved to names in queries — mirrors TrialClass)
  assignedCoachId String?
  assignedCoachAt DateTime?

  // Step 6 — Evaluation (scores stored as { key: 1..10 } JSON + overall %)
  evaluationScores Json?
  overallScore     Float?
  evaluationNotes  String?
  evaluatedAt      DateTime?
  evaluatedById    String?

  // Step 7 — Recommendation engine output
  recommendedLevel    String?
  recommendedBatch    String?
  recommendedTeacherId String?

  // Step 8 — Teacher assignment
  assignedTeacherId String?
  assignedTeacherAt DateTime?

  // Step 13 — Coach decision after the trial
  coachDecision      String?   // ENROLL / REJECT / FOLLOW_UP
  coachDecisionNotes String?
  coachDecisionAt    DateTime?
  followUpAt         DateTime?

  // Conversion (Phase 4) — a real StudentProfile is created on ENROLL.
  // The singular pair points at the primary student; with siblings on the
  // booking, every created account is listed in `convertedStudents`
  // ([{ id, code, name }]) so none of them is lost.
  convertedStudentId   String?
  convertedStudentCode String?
  convertedStudents    Json?
  convertedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  trials     LeadTrial[]

  @@index([status])
  @@index([assignedCoachId])
  @@index([email])
}

// Step 9–12 — a scheduled trial/demo class for a lead, its meeting link,
// reminder state, attendance, and the teacher + parent feedback captured after.
model LeadTrial {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Assignment (TeacherProfile id, resolved to a name in queries)
  teacherId String?

  // Schedule (Step 9)
  scheduledAt     DateTime
  durationMins    Int      @default(30)
  timeZone        String?
  meetingProvider String?  // Zoom / Google Meet
  meetingLink     String?
  // Zoom's own ids, kept so the meeting can be updated or deleted when the
  // trial is rescheduled or cancelled instead of leaking orphaned meetings.
  meetingId       String?
  meetingHostUrl  String?
  status          LeadTrialStatus @default(SCHEDULED)

  // Reminders (Step 10) — the sweep stamps these when a reminder is dispatched
  reminder24hSentAt DateTime?
  reminder1hSentAt  DateTime?

  // Attendance (Step 11)
  attendance String?   // PRESENT / ABSENT
  attendedAt DateTime?

  // Feedback (Step 12)
  teacherRating           Int?     // 1–5
  teacherFeedback         String?
  teacherRecommendsEnroll Boolean?
  parentRating            Int?
  parentFeedback          String?
  parentInterested        Boolean?

  // ── Step 14 — the teacher's trial report ──────────────────────────────────
  // Filled in by the teacher the trial is assigned to, during or after the
  // session. Everything lives on the trial rather than the lead because a
  // student can sit more than one trial: two teachers may hear two different
  // answers, and writing straight onto the lead would lose who was told what.

  // What the teacher actually covered. Separate flags, not one "done" tick,
  // so a half-finished trial can say which half.
  coveredIntro        Boolean @default(false) // introduced the academy
  coveredPresentation Boolean @default(false) // company presentation / video
  coveredDemoLesson   Boolean @default(false) // sample Quran / Arabic lesson
  coveredPackages     Boolean @default(false) // explained subscription packages
  verifiedDetails     Boolean @default(false) // checked the submitted information

  // Details collected from the family during the trial.
  studentAge         Int?
  studentDob         DateTime?
  guardianName       String?
  guardianRelation   String?
  guardianPhone      String?
  guardianEmail      String?
  preferredPackage   String?
  preferredDays      String[] @default([])
  preferredTime      String?
  preferredStartDate DateTime?

  // The teacher's assessment and recommendation.
  assessedLevel       String? // Beginner / Elementary / Intermediate / Advanced
  recommendedCourseId String?
  recommendedCourse   String? // title snapshot, so a renamed course reads right
  reportNotes         String?
  // Null while the report is still a draft; stamped once the teacher submits.
  reportSubmittedAt   DateTime?

  // ── Missing-information form ──────────────────────────────────────────────
  // Families often will not settle on a package or a start date during the
  // trial itself. The coach sends them a link afterwards and their answers
  // land straight back on this row.
  //
  // Only the SHA-256 of the token is kept: a leaked database should not hand
  // out working links. The plaintext is shown to the coach once, at issue.
  infoTokenHash      String?
  infoTokenExpiresAt DateTime?
  infoRequestedAt    DateTime?
  infoRequestedById  String?
  infoSubmittedAt    DateTime?

  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@index([teacherId])
  @@index([scheduledAt])
}

// Immutable audit line for a lead — every meaningful action appends one row,
// powering the "Activity Timeline" tab.
model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // CREATED / STATUS_CHANGED / ASSIGNED / EVALUATED / NOTE / ...
  message   String
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  @@index([leadId])
}

// ─── Notification Management ──────────────────────────────────────────────────
// `type` stays a free-form String: 34 literals are already emitted from 16
// services, and NOTIFICATION_TYPES (notifications/registry.ts) maps each one to
// a category, priority and default channel set. An unregistered type still
// delivers — it just falls back to SYSTEM/MEDIUM/in-app.

enum NotificationCategory {
  ACADEMIC
  ATTENDANCE
  ASSIGNMENT
  ASSESSMENT
  FINANCE
  PROGRESS
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// The row's own lifecycle. Per-channel outcomes live on NotificationDelivery.
enum NotificationStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  WHATSAPP
  SMS
}

enum BroadcastAudience {
  ALL
  ROLE
  COURSE
  BATCH
  STUDENTS
}

// One notification delivered to one user. The topbar bell reads these.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // LEAD_NEW / LEAD_ASSIGNED / ...
  title     String
  body      String?
  link      String?
  // `read` predates the module and is what the bell/widget still read; readAt
  // is the timestamp the reports need. The engine keeps both in step.
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  category    NotificationCategory @default(SYSTEM)
  priority    NotificationPriority @default(MEDIUM)
  status      NotificationStatus   @default(SENT)
  readAt      DateTime?
  archivedAt  DateTime?
  scheduledAt DateTime?
  // Who caused it — null for engine/system events.
  actorId     String?
  actorName   String?
  broadcastId String?
  broadcast   NotificationBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  templateCode String?
  meta        Json?

  deliveries NotificationDelivery[]

  @@index([userId, read])
  @@index([userId, archivedAt, createdAt])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([broadcastId])
}

// One attempt to put a notification down one channel. This is the delivery log
// the admin panel reports on, and what the retry sweep walks.
model NotificationDelivery {
  id             String              @id @default(uuid())
  notificationId String
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         NotificationStatus  @default(QUEUED)
  attempts       Int                 @default(0)
  lastError      String?
  // Set when the channel was deliberately not used (preference off, provider
  // not configured). Distinct from a failure so reports do not conflate them.
  skippedReason  String?
  target         String? // email address / push endpoint / phone
  providerRef    String?
  queuedAt       DateTime            @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?

  @@unique([notificationId, channel])
  @@index([status, channel])
  @@index([queuedAt])
}

// Per-user channel opt-in. Absent row = every channel on (the engine treats a
// missing row as the defaults below, so no backfill is needed).
model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inApp          Boolean  @default(true)
  email          Boolean  @default(true)
  push           Boolean  @default(true)
  whatsapp       Boolean  @default(false)
  sms            Boolean  @default(false)
  // "Mute marketing" in the spec — announcements and other non-essential blasts.
  muteMarketing  Boolean  @default(false)
  // Categories this user has switched off entirely. CRITICAL always overrides.
  mutedCategories NotificationCategory[] @default([])
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

// Admin-editable message template. `isSystem` marks the seeded ones — those may
// be edited but not deleted, because the engine looks them up by code.
model NotificationTemplate {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  description String?
  category    NotificationCategory @default(SYSTEM)
  priority    NotificationPriority @default(MEDIUM)
  channels    NotificationChannel[] @default([])
  subject     String
  bodyText    String
  bodyHtml    String?
  link        String?
  active      Boolean              @default(true)
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([category])
}

// An admin-composed send: broadcast now, or scheduled for later.
model NotificationBroadcast {
  id             String                @id @default(uuid())
  title          String
  body           String
  link           String?
  templateCode   String?
  category       NotificationCategory  @default(SYSTEM)
  priority       NotificationPriority  @default(MEDIUM)
  channels       NotificationChannel[] @default([])
  audience       BroadcastAudience     @default(ALL)
  roles          Role[]                @default([])
  courseId       String?
  batchId        String?
  studentIds     String[]              @default([])
  scheduledAt    DateTime?
  status         NotificationStatus    @default(DRAFT)
  recipientCount Int                   @default(0)
  sentCount      Int                   @default(0)
  failedCount    Int                   @default(0)
  sentAt         DateTime?
  cancelledAt    DateTime?
  createdById    String?
  createdByName  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  notifications Notification[]

  @@index([status, scheduledAt])
}

// A browser Web Push endpoint. One user may have several (one per device).
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// ─── Student Progress Tracking ────────────────────────────────────────────────
// Foreign keys are plain ids (resolved in the service), mirroring
// StudentProfile.coachId — so the existing academic models stay untouched. The
// raw-SQL migration adds DB-level FKs for cascade integrity where it matters.

// A named skill within a course (English → Grammar, Vocabulary, ...). Graded
// assignments/assessments link to a skill; the engine rolls them into a %.
model ProgressSkill {
  id        String   @id @default(uuid())
  courseId  String
  name      String
  order     Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([courseId, name])
  @@index([courseId])
}

// Cached per-student per-skill mastery %, recomputed by the progress engine.
model StudentSkillProgress {
  id         String   @id @default(uuid())
  studentId  String
  skillId    String
  percentage Float    @default(0)
  sampleSize Int      @default(0) // graded items that fed this figure
  updatedAt  DateTime @updatedAt

  @@unique([studentId, skillId])
  @@index([studentId])
}

// Structured teacher feedback — per-class quick ★ ratings + weekly/monthly notes.
model TeacherFeedback {
  id             String   @id @default(uuid())
  studentId      String
  teacherId      String?
  classSessionId String?
  kind           String   @default("CLASS") // CLASS / WEEKLY / MONTHLY
  participation  Int? // 1..5
  homework       Int?
  communication  Int?
  understanding  Int?
  behavior       Int?
  remarks        String?
  suggestions    String? // improvement tips
  actorId        String?
  actorName      String?
  createdAt      DateTime @default(now())

  @@index([studentId, kind])
  @@index([studentId, createdAt])
  @@index([teacherId])
}

// A learning goal set by the Academic Coach for a student.
model LearningGoal {
  id            String    @id @default(uuid())
  studentId     String
  title         String
  description   String?
  skillId       String?
  currentPct    Int       @default(0)
  targetPct     Int       @default(100)
  deadline      DateTime?
  status        String    @default("ACTIVE") // ACTIVE / ACHIEVED / MISSED / CANCELLED
  createdById   String?
  createdByName String?
  achievedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([studentId, status])
}

// Academic Coach monthly review (one per student per period).
model MonthlyReview {
  id             String   @id @default(uuid())
  studentId      String
  coachId        String?
  periodStart    DateTime
  periodEnd      DateTime
  monthLabel     String // "March 2026"
  academic       Int? // 1..5
  attendance     Int?
  behavior       Int?
  participation  Int?
  learningSpeed  Int?
  homework       Int?
  communication  Int?
  recommendation String? // CONTINUE_BATCH / MOVE_ADVANCED / EXTRA_PRACTICE / PARENT_MEETING
  remarks        String?
  actorId        String?
  actorName      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, periodStart])
  @@index([studentId])
}

// Badge catalogue. Auto-award rules live in the engine; criteria here is display.
model Badge {
  id          String   @id @default(uuid())
  code        String   @unique // PERFECT_ATTENDANCE / ASSIGNMENT_CHAMPION / ...
  name        String
  description String?
  icon        String?
  tone        String? // good / accent / warning
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  awards StudentBadge[]
}

model StudentBadge {
  id        String   @id @default(uuid())
  studentId String
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())
  meta      Json?

  @@unique([studentId, badgeId])
  @@index([studentId])
}

// Risk flag raised by the engine when thresholds trip; coach is notified.
model ProgressRiskFlag {
  id            String    @id @default(uuid())
  studentId     String
  level         String    @default("AT_RISK") // AT_RISK / CRITICAL
  reasons       String[]  @default([])
  attendancePct Float?
  assignmentPct Float?
  assessmentPct Float?
  status        String    @default("OPEN") // OPEN / ACKNOWLEDGED / RESOLVED
  note          String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([studentId, status])
  @@index([status])
}

// Parent meeting scheduled/tracked by the Academic Coach.
model ParentMeeting {
  id           String    @id @default(uuid())
  studentId    String
  coachId      String?
  scheduledAt  DateTime
  status       String    @default("SCHEDULED") // SCHEDULED / COMPLETED / CANCELLED
  agenda       String?
  notes        String?
  actionItems  Json? // [{ text, done }]
  nextReviewAt DateTime?
  actorId      String?
  actorName    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId, status])
}

// Monthly snapshot of computed progress — powers trend + timeline charts.
model ProgressSnapshot {
  id            String   @id @default(uuid())
  studentId     String
  periodStart   DateTime
  periodEnd     DateTime
  monthLabel    String
  attendancePct Float    @default(0)
  assignmentPct Float    @default(0)
  assessmentPct Float    @default(0)
  feedbackScore Float    @default(0)
  coachScore    Float    @default(0)
  overallScore  Float    @default(0)
  statusLabel   String   @default("AVERAGE") // EXCELLENT / GOOD / AVERAGE / NEEDS_ATTENTION / CRITICAL
  rank          Int?
  createdAt     DateTime @default(now())

  @@unique([studentId, periodStart])
  @@index([studentId])
}

// ─── Finance & Reporting ──────────────────────────────────────────────────────
// Extends the existing Invoice / Payment / Payout / Expense building blocks with
// fee plans, discounts, scholarships, refunds, receipts and payroll config.
// Foreign keys that would over-couple the academic models stay plain-id (resolved
// in the service, like StudentProfile.coachId); the raw-SQL migration adds
// DB-level FKs for cascade integrity where a relation is declared above.

enum FeePlanCycle {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum FeeComponentType {
  ADMISSION
  COURSE
  REGISTRATION
  MATERIAL
  EXAMINATION
  CERTIFICATE
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountReason {
  SCHOLARSHIP
  SIBLING
  PROMOTIONAL
  STAFF
  MANUAL
}

enum ScholarshipStatus {
  REQUESTED
  APPROVED
  REJECTED
  APPLIED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

enum PayrollModel {
  FIXED
  PER_CLASS
  PER_HOUR
  PER_STUDENT
  HYBRID
}

// A reusable fee plan (Monthly / Quarterly / Yearly / Custom) with N components.
model FeePlan {
  id          String       @id @default(uuid())
  name        String
  cycle       FeePlanCycle @default(MONTHLY)
  courseId    String?      // optional link to a course (plain id, resolved in service)
  /*
   * No `currency` here any more. A plan prices its components in all three, and
   * an invoice is raised in the currency the *student* is billed in — a field
   * on the plan saying otherwise was the second source of truth that made
   * recurring invoices disagree with the first one.
   */
  description String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  components  FeePlanComponent[]
  assignments StudentFeeAssignment[]
  packages    Package[]

  @@index([active])
}

model FeePlanComponent {
  id     String           @id @default(uuid())
  planId String
  plan   FeePlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  type   FeeComponentType @default(COURSE)
  label  String

  /*
   * One amount per currency, exactly as a package carries. A plan used to hold
   * a single figure plus a `currency` on the plan itself, so a family in Dubai
   * got their first invoice in dirhams and every recurring one after it in
   * dollars — the same package billed in two currencies at two amounts.
   *
   * AED and GBP are nullable because these rows predate them. A cycle that
   * cannot be priced in the family's currency raises no invoice and says so,
   * rather than billing them in somebody else's money.
   */
  amountUSD Decimal        @db.Decimal(10, 2)
  amountAED Decimal?       @db.Decimal(10, 2)
  amountGBP Decimal?       @db.Decimal(10, 2)

  @@index([planId])
}

// Links a student to a recurring fee plan. The auto-generator reads active rows
// whose nextRunAt is due and mints an invoice for the period.
model StudentFeeAssignment {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId       String
  plan         FeePlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  startDate    DateTime       @default(now())
  nextRunAt    DateTime?      // when the next recurring invoice is due (null = one-time/done)
  active       Boolean        @default(true)
  autoGenerate Boolean        @default(true)
  discountId   String?        // default discount applied to generated invoices
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([studentId])
  @@index([planId])
  @@index([active])
}

// A reusable discount definition (percentage or fixed) applied to invoices.
model Discount {
  id          String         @id @default(uuid())
  code        String?        @unique
  name        String
  type        DiscountType   @default(PERCENTAGE)
  value       Decimal        @db.Decimal(10, 2)
  reason      DiscountReason @default(PROMOTIONAL)
  description String?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([active])
}

// A scholarship request → review → approve → applied (becomes an invoice discount).
model Scholarship {
  id              String            @id @default(uuid())
  studentId       String
  student         StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name            String
  type            DiscountType      @default(PERCENTAGE)
  value           Decimal           @db.Decimal(10, 2)
  reason          String?
  status          ScholarshipStatus @default(REQUESTED)
  requestedById   String?
  requestedByName String?
  reviewedById    String?
  reviewedByName  String?
  reviewNotes     String?
  appliedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([studentId])
  @@index([status])
}

// A refund request → approve → processed, with immutable history.
model Refund {
  id              String       @id @default(uuid())
  invoiceId       String?
  invoice         Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId       String?
  studentId       String?
  amount          Decimal      @db.Decimal(10, 2)
  currency        String       @default("USD")
  reason          String
  method          String?      // BANK_TRANSFER / UPI / CARD / CASH / ...
  status          RefundStatus @default(REQUESTED)
  requestedById   String?
  requestedByName String?
  approvedById    String?
  approvedByName  String?
  reviewNotes     String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([studentId])
}

// How a teacher / staff member is paid. Drives payout bulk-generation.
model PayrollConfig {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  model          PayrollModel @default(FIXED)
  baseSalary     Decimal?     @db.Decimal(10, 2)
  perClassRate   Decimal?     @db.Decimal(10, 2)
  perHourRate    Decimal?     @db.Decimal(10, 2)
  perStudentRate Decimal?     @db.Decimal(10, 2)
  standardBonus  Decimal      @default(0) @db.Decimal(10, 2)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}



// ---------------------------------------------------------------------------
// Dashboard Management
// ---------------------------------------------------------------------------

// A parent login linked to one or more children. A parent may have several
// children, and a student may have two guardians with separate logins.
model ParentLink {
  id           String         @id @default(uuid())
  parentUserId String
  parentUser   User           @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship String?
  isPrimary    Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@unique([parentUserId, studentId])
  @@index([parentUserId])
  @@index([studentId])
}

// Registry of every dashboard widget. Seeded by scripts/migrate-dashboard.cjs;
// `roles` is the set of role dashboards a widget is even eligible for.
model DashboardWidget {
  key         String   @id
  title       String
  description String?
  category    String   @default("KPI") // KPI | CHART | TABLE | LIST | ACTION
  defaultSize String   @default("MD")  // SM | MD | LG | FULL
  roles       String[] @default([])
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  roleSettings RoleWidgetSetting[]
  userLayouts  UserWidgetLayout[]
}

// Admin-controlled enable/disable of a widget for a whole role.
model RoleWidgetSetting {
  id        String          @id @default(uuid())
  role      Role
  widgetKey String
  widget    DashboardWidget @relation(fields: [widgetKey], references: [key], onDelete: Cascade)
  enabled   Boolean         @default(true)
  order     Int             @default(0)
  updatedAt DateTime        @updatedAt

  @@unique([role, widgetKey])
  @@index([role])
}

// Per-user personalisation on top of the role settings.
model UserWidgetLayout {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetKey String
  widget    DashboardWidget @relation(fields: [widgetKey], references: [key], onDelete: Cascade)
  order     Int             @default(0)
  size      String?
  hidden    Boolean         @default(false)
  updatedAt DateTime        @updatedAt

  @@unique([userId, widgetKey])
  @@index([userId])
}

model Announcement {
  id            String    @id @default(uuid())
  title         String
  body          String
  type          String    @default("GENERAL") // HOLIDAY | MAINTENANCE | EXAM | COURSE | GENERAL
  audience      String[]  @default([])        // Role names; empty = everyone
  pinned        Boolean   @default(false)
  active        Boolean   @default(true)
  link          String?
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reads AnnouncementRead[]

  @@index([active, publishedAt])
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Module 7 — Student Monthly Assessment + Ranking
//
// Distinct from the `Assessment` model above, which is the online-test engine
// (question bank, timed attempts, auto-marking). THIS is the teacher's
// end-of-billing-cycle evaluation of a student against a per-course rubric.
//
// The period is the student's 28-day SUBSCRIPTION cycle, not the calendar
// month — that is what "one assessment per billing cycle" means, and it keeps
// working when a break shifts a student's cycle. `monthLabel` is the human
// label ("July 2026") shown everywhere, exactly like TeacherSalary.
// ═══════════════════════════════════════════════════════════════════════════

enum AssessmentFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum AssessmentTemplateStatus {
  ACTIVE
  INACTIVE
}

/*
 * DRAFT     — teacher is still working on it (nobody else sees marks)
 * SUBMITTED — handed to the supervisor
 * RETURNED  — supervisor sent it back with a reason; teacher edits and resubmits
 * APPROVED  — supervisor accepted it; not yet visible to the family
 * PUBLISHED — visible in the student panel; read-only unless a supervisor reopens
 */
enum MonthlyAssessmentStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  PUBLISHED
}

// A named grade ladder. Configurable so a course/academy can grade A+..F, or
// 1..5, or Excellent/Good/Needs Work, without a code change.
model GradingScale {
  id        String   @id @default(uuid())
  name      String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bands     GradeBand[]
  templates AssessmentTemplate[]
}

model GradeBand {
  id           String       @id @default(uuid())
  scaleId      String
  scale        GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  grade        String // "A+"
  minPercent   Decimal      @db.Decimal(5, 2)
  maxPercent   Decimal      @db.Decimal(5, 2)
  displayOrder Int          @default(0)

  @@index([scaleId])
}

// The per-course rubric. A new course needs a new row here and nothing else —
// no code change, which is the whole point of the module.
model AssessmentTemplate {
  id             String                   @id @default(uuid())
  name           String
  courseId       String
  course         Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  levelId        String? // optional: a rubric that only applies to one level
  level          Level?                   @relation(fields: [levelId], references: [id], onDelete: SetNull)
  frequency      AssessmentFrequency      @default(MONTHLY)
  maxMarks       Int                      @default(100)
  passingMarks   Int                      @default(40)
  gradingScaleId String?
  gradingScale   GradingScale?            @relation(fields: [gradingScaleId], references: [id], onDelete: SetNull)
  displayOrder   Int                      @default(0)
  status         AssessmentTemplateStatus @default(ACTIVE)
  createdById    String?
  createdByName  String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  criteria    AssessmentCriterion[]
  assessments MonthlyAssessment[]

  // "One ACTIVE template per course+level" is enforced in the service, not here:
  // levelId is nullable and Postgres treats NULLs as distinct, so a unique index
  // would silently allow two active course-wide templates.
  @@index([courseId, status])
}

model AssessmentCriterion {
  id           String             @id @default(uuid())
  templateId   String
  template     AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name         String
  maxMarks     Int
  displayOrder Int                @default(0)
  isMandatory  Boolean            @default(true)

  @@index([templateId])
}

model MonthlyAssessment {
  id             String              @id @default(uuid())
  studentId      String
  student        StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId      String? // TeacherProfile.id (plain, like TeacherEarning)
  courseId       String
  course         Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  templateId     String?
  template       AssessmentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subscriptionId String? // the StudentSubscription whose cycle this covers

  // Billing-cycle anchor
  cycleStart DateTime
  cycleEnd   DateTime
  cycleIndex Int       @default(0)
  monthLabel String // "July 2026"
  dueAt      DateTime?

  assessmentDate DateTime @default(now())

  /*
   * Context snapshotted when the teacher opened the form. Kept on the row so a
   * published report never changes underneath the family — a later attendance
   * correction must not silently rewrite a report they already read.
   */
  levelName            String?
  attendancePct        Int     @default(0)
  attendedClasses      Int     @default(0)
  totalClasses         Int     @default(0)
  assignmentPct        Int     @default(0)
  assignmentsSubmitted Int     @default(0)
  assignmentsTotal     Int     @default(0)
  homeworkPct          Int     @default(0)

  totalMarks   Decimal @default(0) @db.Decimal(6, 2)
  maxMarks     Int     @default(100)
  passingMarks Int     @default(40)
  percentage   Decimal @default(0) @db.Decimal(5, 2)
  grade        String?
  passed       Boolean @default(false)

  teacherRemarks  String?
  recommendations String?

  status         MonthlyAssessmentStatus @default(DRAFT)
  submittedAt    DateTime?
  returnedReason String?
  returnedAt     DateTime?
  reviewedById   String?
  reviewedByName String?
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?
  publishedAt    DateTime?
  reopenedById   String?
  reopenedByName String?
  reopenedAt     DateTime?

  // Last due/overdue reminder, so the daily sweep nags once a day and not once
  // every five minutes.
  lastReminderAt DateTime?

  scores   MonthlyAssessmentScore[]
  feedback AssessmentFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One assessment per student per course per billing cycle.
  @@unique([studentId, courseId, cycleStart])
  @@index([status])
  @@index([teacherId, status])
  @@index([courseId, cycleStart])
  @@index([studentId, publishedAt])
}

model MonthlyAssessmentScore {
  id           String            @id @default(uuid())
  assessmentId String
  assessment   MonthlyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterionId  String? // null once the criterion is deleted from the template

  // Name and ceiling are SNAPSHOTS. Editing a template must not retroactively
  // rewrite last cycle's report.
  criterionName String
  maxMarks      Int
  marks         Decimal @default(0) @db.Decimal(6, 2)
  comment       String?
  displayOrder  Int     @default(0)

  @@index([assessmentId])
}

// Parent/guardian feedback on a published report. Submitted from the STUDENT
// panel — this deployment has no parent login, so the family's single account
// is the student account.
model AssessmentFeedback {
  id              String            @id @default(uuid())
  assessmentId    String
  assessment      MonthlyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  submittedById   String?
  submittedByName String?
  rating          Int? // 1..5
  comment         String
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime          @default(now())

  @@index([assessmentId])
  @@index([reviewedAt])
}

// ─── Ranking ────────────────────────────────────────────────────────────────

model StudentRanking {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cycleStart DateTime
  cycleEnd   DateTime
  monthLabel String

  // Each component is normalised to 0..100 before its weightage is applied, so
  // the weights in the ranking config read exactly as the spec's percentages.
  assessmentScore Decimal @default(0) @db.Decimal(6, 2)
  attendancePct   Decimal @default(0) @db.Decimal(5, 2)
  assignmentScore Decimal @default(0) @db.Decimal(5, 2)
  homeworkPct     Decimal @default(0) @db.Decimal(5, 2)
  teacherRating   Decimal @default(0) @db.Decimal(5, 2)
  totalScore      Decimal @default(0) @db.Decimal(6, 2)

  rank          Int
  previousRank  Int?
  totalStudents Int       @default(0)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@unique([courseId, cycleStart, studentId])
  @@index([courseId, cycleStart, rank])
  @@index([studentId])
}

enum RankingBadgeRule {
  RANK_1
  RANK_2
  RANK_3
  TOP_10
  PERFECT_ATTENDANCE
  MOST_IMPROVED
}

model RankingBadgeConfig {
  id      String    @id @default(uuid())
  rule    RankingBadgeRule @unique
  label   String
  icon    String
  enabled Boolean   @default(true)

  // TOP_10 → the N; PERFECT_ATTENDANCE → the % that counts as perfect;
  // MOST_IMPROVED → the minimum rank improvement that earns it.
  threshold    Int?
  displayOrder Int  @default(0)
}

model RankingBadge {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rule       RankingBadgeRule
  label      String
  icon       String
  cycleStart DateTime
  monthLabel String
  awardedAt  DateTime       @default(now())

  @@unique([studentId, courseId, rule, cycleStart])
  @@index([studentId])
  @@index([courseId, cycleStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Module 8 — Staff Meeting & Collaboration Management
//
// Named `StaffMeeting*` on purpose. `LmsMeeting` is the legacy JSON-attendee
// row the lms-data module still serves, and `ParentMeeting` is the coach↔parent
// review; neither is this. The spec's late addition — "Academic Coach and
// Supervisor can schedule a meeting with Student also" — is why a participant
// is a plain User rather than a staff record: the same meeting machinery has to
// carry a student invitee without a parallel table for them.
// ─────────────────────────────────────────────────────────────────────────────

enum StaffMeetingType {
  // Automatic recurring (8.1)
  BIWEEKLY_TEACHER
  MONTHLY_STAFF
  TRAINING
  PERFORMANCE_REVIEW
  // Manual (8.1)
  SUPERVISOR_TEACHER
  COACH_TEACHER
  ADMIN_STAFF
  TEACHER_TEACHER
  DEPARTMENT
  // The spec's addendum: coach/supervisor ↔ student
  STUDENT_MEETING
}

enum StaffMeetingStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum StaffMeetingPlatform {
  JITSI
  ZOOM
  TEAMS
  OTHER
}

/*
 * INVITED is not in the spec's list, and is the point: until the meeting has
 * actually run, a participant is neither present nor absent. Defaulting them to
 * ABSENT would show every upcoming meeting as fully missed.
 */
enum MeetingAttendanceStatus {
  INVITED
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum MeetingMinutesStatus {
  NOT_STARTED
  DRAFT
  PUBLISHED
}

enum MeetingActionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MeetingActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model StaffMeeting {
  id          String           @id @default(uuid())
  title       String
  type        StaffMeetingType
  description String? // the agenda

  startsAt     DateTime
  endsAt       DateTime
  durationMins Int
  timeZone     String?

  platform    StaffMeetingPlatform @default(JITSI)
  meetingLink String?
  // Provider-side id, so a reschedule or cancellation can be pushed to Zoom
  // rather than leaving a live room pointing at a meeting that moved.
  externalId  String?

  status StaffMeetingStatus @default(SCHEDULED)

  organizerId   String
  organizerName String?

  seriesId        String?
  series          StaffMeetingSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  occurrenceIndex Int?

  /*
   * Minutes live on the meeting rather than in a table of their own: there is
   * exactly one set per meeting, and a 1:1 table buys a join for nothing.
   * They stay editable until `minutesStatus` reaches PUBLISHED.
   */
  minutesStatus      MeetingMinutesStatus @default(NOT_STARTED)
  summary            String?
  discussionPoints   String?
  decisions          String?
  remarks            String?
  minutesPublishedAt DateTime?
  minutesById        String?
  minutesByName      String?

  startedAt       DateTime?
  endedAt         DateTime?
  cancelledAt     DateTime?
  cancelledByName String?
  cancelReason    String?
  rescheduledFrom DateTime?
  rescheduleNote  String?

  // Reminder bookkeeping, so the hourly sweep sends each notice once and not
  // once per sweep. Same shape as MonthlyAssessment.lastReminderAt.
  reminder24SentAt DateTime?
  reminder1SentAt  DateTime?
  startedNotifiedAt DateTime?
  absenceMarkedAt  DateTime?

  participants StaffMeetingParticipant[]
  actionItems  MeetingActionItem[]
  attachments  MeetingAttachment[]
  auditLog     MeetingAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt, status])
  @@index([status, startsAt])
  @@index([organizerId])
  @@index([type, startsAt])
  @@index([seriesId])
}

model StaffMeetingParticipant {
  id        String       @id @default(uuid())
  meetingId String
  meeting   StaffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Snapshot of the role at invite time: a teacher promoted to supervisor next
  // year must not rewrite who attended as what last year.
  role        Role
  isOrganizer Boolean @default(false)
  isOptional  Boolean @default(false)

  status       MeetingAttendanceStatus @default(INVITED)
  joinedAt     DateTime?
  leftAt       DateTime?
  durationMins Int                     @default(0)
  lateMinutes  Int                     @default(0)
  excuseReason String?
  markedById   String?
  markedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, userId])
  @@index([userId, status])
  @@index([meetingId, status])
}

model MeetingActionItem {
  id        String       @id @default(uuid())
  meetingId String
  meeting   StaffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  description    String
  assignedToId   String?
  assignedToName String?
  dueDate        DateTime?
  priority       MeetingActionPriority @default(MEDIUM)
  status         MeetingActionStatus   @default(PENDING)
  completedAt    DateTime?
  completionNote String?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([assignedToId, status])
  @@index([meetingId])
  @@index([status, dueDate])
}

model MeetingAttachment {
  id        String       @id @default(uuid())
  meetingId String
  meeting   StaffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // RECORDING / DOCUMENT / PRESENTATION / TRAINING_MATERIAL
  kind           String   @default("DOCUMENT")
  title          String
  url            String
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([meetingId])
}

/*
 * The recurrence rule behind an automatic meeting (8.2). Occurrences are
 * generated ahead by a sweep and are ordinary StaffMeeting rows once created —
 * so an admin can move or cancel a single occurrence (8.3) without the series
 * regenerating it.
 */
model StaffMeetingSeries {
  id     String           @id @default(uuid())
  name   String
  type   StaffMeetingType
  active Boolean          @default(true)

  intervalWeeks Int      @default(2) // 2 = biweekly
  weekday       Int      @default(6) // 0=Sun … 6=Sat
  startTime     String   @default("18:00") // HH:mm, academy local
  durationMins  Int      @default(60)
  anchorDate    DateTime // the first occurrence this series counts from

  organizerId   String?
  organizerName String?
  platform      StaffMeetingPlatform @default(JITSI)
  description   String?

  // Which roles are invited, as role names. A list rather than booleans so a
  // new role does not need a migration to become invitable.
  inviteRoles String[] @default([])
  // Roles invited as OPTIONAL attendees — §8.2's "(Optional: Academic Coach and
  // Admin may attend.)" for the biweekly staff meeting. They are invited and
  // reminded like anyone else; their absence just does not count.
  optionalInviteRoles String[] @default([])

  generateAheadWeeks Int       @default(8)
  lastGeneratedAt    DateTime?

  meetings StaffMeeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, type])
}

/*
 * "All meeting actions shall be recorded in the audit log." There is no
 * general-purpose audit table in this codebase — StudentActivity is scoped to a
 * student — so meetings carry their own. Append-only: rows are written and read,
 * never updated, which is what makes the trail worth having.
 */
model MeetingAuditLog {
  id        String       @id @default(uuid())
  meetingId String
  meeting   StaffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // CREATED / UPDATED / RESCHEDULED / CANCELLED / STARTED / ENDED / JOINED /
  // LEFT / ATTENDANCE_MARKED / MINUTES_SAVED / MINUTES_PUBLISHED /
  // ACTION_ASSIGNED / ACTION_UPDATED / ATTACHMENT_ADDED / REMINDER_SENT
  action      String
  description String?
  meta        Json?
  actorId     String?
  actorName   String?
  createdAt   DateTime @default(now())

  @@index([meetingId, createdAt])
  @@index([action, createdAt])
}
