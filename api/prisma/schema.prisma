// LMS data model.
// DATABASE_URL points at local Docker Postgres today and at Supabase later;
// DIRECT_URL exists because Prisma migrations cannot run through a pooler.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS compiles to CommonJS; without this the generated client emits ESM
  // and ts-node/Node disagree about how to load it.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7 keeps connection URLs out of the schema — see prisma.config.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPERVISOR
  ACADEMIC_COACH
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  TRIAL
  PAUSED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  TRIAL
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

// A teacher-initiated class reschedule. Student reschedules apply immediately
// (auto-approved); a teacher's must be approved by an academic coach first, so
// they are queued here. PENDING → APPROVED (class moved) or REJECTED.
enum ClassRescheduleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BatchStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// Per-session student attendance (attendance is session-based, not date-based).
enum StudentAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
  LEAVE_APPROVED
  NO_SHOW
}

enum TeacherAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  CLASS_CANCELLED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  ASSIGNED
  DRAFT
  SUBMITTED
  LATE_SUBMITTED
  UNDER_REVIEW
  EVALUATED
  RETURNED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

// ─── Identity ─────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  status       UserStatus @default(ACTIVE)
  country      String?
  timezone     String?
  avatarUrl    String?
  lastLoginAt  DateTime?
  phone        String?
  gender       String?
  joiningDate  DateTime?
  salary       Decimal?   @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  refreshTokens  RefreshToken[]
  leaveRequests  LeaveRequest[]
  payouts        Payout[]
  notifications  Notification[]
  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
  payrollConfig  PayrollConfig?
  parentLinks    ParentLink[]
  widgetLayouts  UserWidgetLayout[]
  announcementReads AnnouncementRead[]
  meetingInvites StaffMeetingParticipant[]

  @@index([role, status])
}

// Only the hash is stored, so a database leak cannot replay a session.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model StudentProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode     String    @unique
  phone           String?
  gender          String?
  dateOfBirth     DateTime?
  guardianName    String?
  profession      String?
  fees            Decimal?  @db.Decimal(10, 2)

  /*
   * The currency this family is billed in, fixed when their account is made
   * rather than resolved per request. A student who travels, or opens the site
   * on holiday, must not find their monthly bill quoted in another currency —
   * and an invoice already issued has its own currency column regardless.
   */
  billingCurrency String    @default("USD")

  /*
   * The family's Stripe customer, created the first time they pay and reused
   * after. Kept so a returning family is not asked for their card again, and so
   * refunds and disputes land on one customer rather than a new one per
   * invoice. Null until they have paid online at least once.
   */
  stripeCustomerId String? @unique

  joiningDate     DateTime?
  lastPaymentDate DateTime?
  nextPaymentDate DateTime?

  // Profile enrichment (managed from the Student Management hub)
  nationality        String?
  address            String?
  timeZone           String?

  // Academic information
  currentGrade       String?
  currentSchool      String?
  board              String?
  learningLevel      String?
  preferredLanguage  String?
  learningGoal       String?

  // Parent / Guardian contact details. A parent may additionally have a login of
  // their own — see ParentLink / the `parentLinks` relation below.
  parentName         String?
  parentRelationship String?
  parentEmail        String?
  parentMobile       String?
  parentWhatsapp     String?

  // Assigned Academic Coach (a User with role ACADEMIC_COACH; plain id, resolved in service)
  coachId            String?

  // Documents: JSON array of { id, type, label, url, uploadedAt, archived }
  documents          Json?

  // Freeze / On-hold
  onHoldReason       String?
  onHoldAt           DateTime?

  enrollments Enrollment[]
  submissions Submission[]
  invoices    Invoice[]
  attendance  ClassAttendee[]
  chatMessages ChatMessage[]
  batches     BatchStudent[]
  activities  StudentActivity[]
  transfers   StudentTransfer[]
  assessmentAttempts AssessmentAttempt[]
  feeAssignments StudentFeeAssignment[]
  scholarships   Scholarship[]
  parentLinks    ParentLink[]
  subscriptionRequests SubscriptionRequest[]
  nextCycle            SubscriptionNextCycle?
  subscriptions        StudentSubscription[]
  monthlyAssessments   MonthlyAssessment[]
  rankings             StudentRanking[]
  rankingBadges        RankingBadge[]
}

// A requested change (teacher / batch / course) that needs approval before it
// applies. Approve → the change is executed and a TIMELINE + AUDIT row logged.
model StudentTransfer {
  id              String         @id @default(uuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind            String         // TEACHER / BATCH / COURSE
  reason          String
  payload         Json           // { enrollmentId, toTeacherId } | { batchId } | { courseId, teacherId, status }
  fromLabel       String?
  toLabel         String?
  status          String         @default("PENDING") // PENDING / APPROVED / REJECTED
  requestedById   String?
  requestedByName String?
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  createdAt       DateTime       @default(now())

  @@index([studentId, status])
  @@index([status])
}

enum SubscriptionRequestType {
  PACKAGE_CHANGE
  SCHEDULE_CHANGE
  // Migrating a student from one subscription model to another (e.g. legacy
  // Monthly Package → Hourly Subscription). Applied at the next cycle like any
  // other change, so historical invoices/attendance stay on the old model.
  MODEL_CHANGE
  // A student (or a coach on their behalf) pausing the subscription for a fixed
  // window. Approved like any other request, but it does NOT queue a next-cycle
  // change — it schedules a break window the cron applies (status ON_BREAK,
  // classes paused, cycle extended) at the start date and resolves at the end.
  BREAK_REQUEST
}

// How a subscription model prices a student. This is the ONLY axis code branches
// on — everything else about a model (name, tiers, features) is data. A new
// model (Corporate/Promotional/Summer/Family) is a `SubscriptionModel` row that
// reuses one of these two modes and needs no code change.
enum SubscriptionPricingMode {
  FIXED_MONTHLY // legacy Monthly Package — a flat price per cycle
  HOURLY        // hourly rate × (duration ÷ 60) × weekly classes × 4 weeks
}

enum StudentSubscriptionStatus {
  PENDING // agreed but not yet started (legacy waypoint)
  PENDING_PAYMENT // enrolled, invoice raised, awaiting first payment — no classes/teacher block yet
  ACTIVE
  PAUSED
  ON_BREAK // an approved break is currently running — classes paused, cycle extended, slot reserved
  ENDED // superseded by a migration, or cancelled
}

// PENDING → APPROVED → APPLIED, or PENDING → REJECTED. APPROVED and APPLIED are
// deliberately separate: approving only writes the next cycle's settings, and
// nothing the student can see changes until the cycle actually turns. Collapsing
// them would tell a student their package changed while they are still being
// billed and taught on the old one.
enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

// A student asking to change their package or their class schedule. Students
// never edit either directly — they raise one of these, an academic coach
// decides, and an approved change lands at the next billing cycle.
model SubscriptionRequest {
  id        String                    @id @default(uuid())
  studentId String
  student   StudentProfile            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      SubscriptionRequestType
  status    SubscriptionRequestStatus @default(PENDING)
  reason    String?

  // PACKAGE_CHANGE
  requestedPackageId String?
  requestedPackage   Package? @relation(fields: [requestedPackageId], references: [id], onDelete: SetNull)

  // SCHEDULE_CHANGE
  requestedDays      String[]  @default([])
  requestedTime      String? // "18:00", same shape as Batch.startTime
  requestedStartDate DateTime?

  // BREAK_REQUEST — the window the family asked to pause for. Kept on the request
  // as the record of what was asked; the approved window is copied onto the
  // subscription, where the cron reads it.
  breakStartDate DateTime?
  breakEndDate   DateTime?
  // Which batch the change is for, and — when others share it — the batch the
  // coach moves this student into instead of rewriting everyone's timetable.
  batchId       String?
  targetBatchId String?

  // What the student was on when they asked, kept as text: the underlying rows
  // can change or be deleted, and a decision has to stay readable afterwards.
  fromLabel String?
  toLabel   String?

  decidedById   String?
  decidedByName String?
  decidedAt     DateTime?
  reviewNotes   String?
  appliedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@index([status])
}

// What this student's subscription becomes when the current cycle ends. Written
// only by an approval, read only by the rollover. Empty for almost every
// student almost all the time — a row existing means something is queued.
model SubscriptionNextCycle {
  id        String         @id @default(uuid())
  studentId String         @unique
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  nextPackageId String?
  nextPackage   Package? @relation(fields: [nextPackageId], references: [id], onDelete: SetNull)

  nextDays      String[]  @default([])
  nextTime      String?
  nextStartDate DateTime?
  nextBatchId   String?
  // A teacher change queued for the next cycle (AC "Modify Schedule → Next cycle
  // only" with a new teacher). Applied by retiming the batch's teacher at rollover.
  nextTeacherId String?

  updatedAt DateTime @updatedAt
}

// Immutable log for a student — every meaningful action appends one row.
// One table powers the Timeline, Audit Log, Private Notes and Communication
// History tabs (distinguished by `kind`). Nothing is ever deleted.
model StudentActivity {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind        String         // TIMELINE / AUDIT / NOTE / COMMUNICATION / STATUS
  type        String         // CREATED / STATUS_CHANGED / TEACHER_CHANGED / BATCH_CHANGED / COURSE_CHANGED / NOTE / EMAIL / WHATSAPP / SMS / CALL / NOTIFICATION / ...
  title       String
  description String?
  channel     String?        // COMMUNICATION only: EMAIL / WHATSAPP / SMS / NOTIFICATION / CALL / INTERNAL
  visibility  String         @default("STAFF") // STAFF = admin + coach only
  meta        Json?
  actorId     String?
  actorName   String?
  createdAt   DateTime       @default(now())

  @@index([studentId, kind])
  @@index([studentId, createdAt])
}

model TeacherProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherCode    String   @unique
  bio            String?
  specialisation String?
  hourlyRate     Decimal? @db.Decimal(10, 2)
  courseId       String?
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  // ── Teacher Management: teaching assignment ──
  subjects      String[] @default([]) // e.g. English, Mathematics
  levels        String[] @default([]) // e.g. Grade 1..5
  teachingModes String[] @default([]) // One to One / Group Class

  // ── Weekly availability ({ Monday: [{from,to}], ... }); teacher submits,
  //    admin approves ──
  availability            Json?
  availabilityApproved    Boolean   @default(false)
  availabilitySubmittedAt DateTime?

  // ── Profile enrichment (mirrors TeacherRegistration, editable by admin) ──
  gender          String?
  dateOfBirth     DateTime?
  nationality     String?
  timeZone        String?
  address         String?
  whatsapp        String?
  qualification   String?
  experienceYears String?
  languages       String[] @default([])
  joiningDate     DateTime?

  // Documents copied from the registration (relative /uploads paths)
  documents Json?

  // ── System-generated rating (0..5, cached) ──
  rating      Float?
  ratingCount Int?

  // ── Teacher Salary Payment (Wise): payout recipient details (admin-editable) ──
  payoutCurrency  String? // currency the teacher is paid in (e.g. USD)
  recipientName   String? // name on the receiving bank account
  payoutCountry   String?
  payoutBankName  String?
  iban            String? // IBAN or account number
  swift           String? // SWIFT / BIC
  wiseRecipientId String? // Wise recipient id, once created

  // Archived teachers are hidden from active management but not deleted.
  archived Boolean @default(false)

  enrollments Enrollment[]
  classes     ClassSession[]
  chatMessages ChatMessage[]
  batches     Batch[]
  assignments Assignment[]
  assessments Assessment[]
  registrations TeacherRegistration[]
}

// ─── Catalogue ────────────────────────────────────────────────────────────────

model Level {
  id      String   @id @default(uuid())
  name    String   @unique
  order   Int
  courses Course[]

  assessmentTemplates AssessmentTemplate[]
}

model Course {
  id            String       @id @default(uuid())
  title         String
  slug          String       @unique
  description   String?
  levelId       String?
  level         Level?       @relation(fields: [levelId], references: [id], onDelete: SetNull)
  price         Decimal      @db.Decimal(10, 2)
  durationWeeks Int          @default(12)
  status        CourseStatus @default(DRAFT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  enrollments Enrollment[]
  classes     ClassSession[]
  assignments Assignment[]
  assessments Assessment[]
  teachers    TeacherProfile[]
  batches     Batch[]

  assessmentTemplates AssessmentTemplate[]
  monthlyAssessments  MonthlyAssessment[]
  rankings            StudentRanking[]
  rankingBadges       RankingBadge[]

  @@index([status])
}

model Package {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?

  /*
   * One amount per currency the academy sells in, entered by hand.
   *
   * Deliberately not one price converted at an exchange rate: this figure is
   * what a family is billed every month, and a rate that moves would bill them
   * a different amount each cycle — which is the one thing the subscription
   * module exists to prevent. USD is the column the single `price` used to be,
   * renamed rather than duplicated so there is still exactly one number per
   * currency.
   *
   * AED and GBP are nullable because the rows existed before they did. A
   * missing one is never silently substituted with USD — a price shown in the
   * wrong currency is worse than no price at all.
   */
  priceUSD        Decimal  @db.Decimal(10, 2)
  priceAED        Decimal? @db.Decimal(10, 2)
  priceGBP        Decimal? @db.Decimal(10, 2)
  classesPerMonth Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  /*
   * Subscription-model attributes. Which model this plan belongs to decides how
   * it is priced: a FIXED_MONTHLY model uses priceUSD/AED/GBP above; an HOURLY
   * model uses hourlyRate* below and multiplies by the student's chosen duration
   * and weekly classes. All nullable because the columns arrived after the rows
   * and a legacy package is treated as a FIXED_MONTHLY plan with no model link.
   */
  modelId         String?
  model           SubscriptionModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  tier            String? // Simple/Essential/Premium/Elite or Basic/Standard/Premium/Platinum — free text so new tiers need no enum change
  durationMinutes Int?    // 30 / 60 — fixed for a monthly plan; chosen per-subscription for hourly
  weeklyClasses   Int?    // fixed for a monthly plan
  monthlyHours    Int?
  hourlyRateUSD   Decimal? @db.Decimal(10, 2)
  hourlyRateAED   Decimal? @db.Decimal(10, 2)
  hourlyRateGBP   Decimal? @db.Decimal(10, 2)
  rescheduleLimit Int      @default(0)
  familyDiscountPct Decimal @default(0) @db.Decimal(5, 2)
  // Typed feature toggles: { nativeArabicTeacher, eCertificate, eSyllabus,
  // directChat, coachingSessions, progressReport, topRatedTeacher, videoRecording }
  featureMatrix   Json?
  eSyllabus       Boolean  @default(false) // mirrored from featureMatrix for querying
  displayOrder    Int      @default(0)
  badge           String?  // "Popular", "Best value" — display only

  /*
   * The fee plan that bills this package. Packages and billing grew up apart —
   * a package carried a price nobody charged, while invoices came from a fee
   * plan that knew nothing about packages. Without this link, approving a
   * "4 hours → 8 hours" change moves the student onto more classes and keeps
   * billing them the old amount. Optional because a package may exist before
   * anyone has decided how to bill it; the approval screen says so plainly
   * rather than inventing a price.
   */
  feePlanId String?
  feePlan   FeePlan? @relation(fields: [feePlanId], references: [id], onDelete: SetNull)

  enrollments          Enrollment[]
  subscriptionRequests SubscriptionRequest[]
  nextCycles           SubscriptionNextCycle[]
  studentSubscriptions StudentSubscription[]
}

// A subscription model the academy sells under. Admin-configurable rows so new
// models (Corporate/Promotional/Summer/Family) can be added without code — the
// only thing code reads is `pricingMode`. `key` is a stable slug; MONTHLY and
// HOURLY are seeded on boot.
model SubscriptionModel {
  id           String                  @id @default(uuid())
  key          String                  @unique // MONTHLY / HOURLY / CORPORATE …
  name         String
  pricingMode  SubscriptionPricingMode
  active       Boolean                 @default(true)
  displayOrder Int                     @default(0)
  createdAt    DateTime                @default(now())

  packages             Package[]
  studentSubscriptions StudentSubscription[]
}

// The one stored record of what a student is subscribed to. Before this, a
// "subscription" was assembled read-only from three unrelated rows (Enrollment +
// Batch + StudentFeeAssignment), which could not hold live counters. This row
// snapshots the price/tier/limits agreed at enrolment so later catalogue edits
// never rewrite an existing subscription, and a migration ENDs the old row and
// creates a new one — leaving historical invoices/attendance untouched.
model StudentSubscription {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId String? // the Enrollment this subscription bills (plain id, resolved in service)
  courseId     String?

  modelId     String
  model       SubscriptionModel       @relation(fields: [modelId], references: [id])
  pricingMode SubscriptionPricingMode // snapshot of the model's mode at creation
  planId      String?
  plan        Package?                @relation(fields: [planId], references: [id], onDelete: SetNull)
  tier        String?

  // Snapshots — the numbers agreed, immune to later catalogue changes.
  currency        String
  monthlyPrice    Decimal? @db.Decimal(10, 2) // FIXED_MONTHLY: the flat price; HOURLY: the computed monthly estimate
  hourlyRate      Decimal? @db.Decimal(10, 2) // HOURLY only
  durationMinutes Int
  weeklyClasses   Int
  monthlyHours    Int

  billingCycle FeePlanCycle @default(MONTHLY)
  startDate    DateTime     @default(now())
  renewalDate  DateTime?
  // The official cycle start, set only after the first payment. Distinct from the
  // preferred start (carried on the lead/trial). Classes and the 28-day cycle are
  // anchored here; never backdated. adminStartOverride lets staff force an earlier
  // start than the preferred date.
  actualCycleStartDate DateTime?
  adminStartOverride   Boolean  @default(false)
  // Preferred teacher gender carried from the lead, so a renewal re-assignment can
  // honour it without reopening the lead. Male / Female / Either.
  preferredTeacherGender String?

  remainingClasses  Int     @default(0)
  completedClasses  Int     @default(0)
  minutesUsed       Int     @default(0) // taught minutes consumed this cycle; reset at cycle close
  rescheduleCounter Int     @default(0) // student's own reschedules this cycle
  rescheduleLimit   Int     @default(0) // snapshot from the plan (Simple 0 / Essential 2 / Premium 4 / Elite 6)
  // The assigned teacher's reschedules of THIS student this cycle, capped at 2.
  // Per-student because a student has one teacher; resets each cycle like the above.
  teacherRescheduleCounter Int @default(0)
  familyDiscountPct Decimal @default(0) @db.Decimal(5, 2)

  batchId         String? // the recurring-schedule Batch (plain id) — set only on activation
  feeAssignmentId String? // the recurring StudentFeeAssignment (plain id) — set only on activation

  // The schedule the family chose, held while PENDING_PAYMENT so activation can
  // build the batch + 28-day sessions after payment without reopening the lead.
  pendingDays        String[]  @default([])
  pendingTime        String?
  pendingTeacherId   String?
  preferredStartDate DateTime? // the family's requested commencement date (preferred, not actual)

  // Approved break window (set on approval; read by the break cron). While a
  // break runs, status is ON_BREAK. Cleared on resume. The window's duration is
  // added to renewalDate + the fee assignment's nextRunAt so billing is postponed
  // rather than lost, and the reserved batch is kept untouched throughout.
  breakStartDate DateTime?
  breakEndDate   DateTime?

  status    StudentSubscriptionStatus @default(ACTIVE)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([studentId, status])
  @@index([status])
}

// ─── Learning ─────────────────────────────────────────────────────────────────

model Enrollment {
  id          String           @id @default(uuid())
  studentId   String
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   String?
  teacher     TeacherProfile?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  packageId   String?
  package     Package?         @relation(fields: [packageId], references: [id], onDelete: SetNull)
  status      EnrollmentStatus @default(PENDING)
  progress    Int              @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // A student sits in a given course once.
  @@unique([studentId, courseId])
  @@index([status])
}

model ClassSession {
  id         String         @id @default(uuid())
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  batchId    String?
  batch      Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  title      String
  startsAt   DateTime
  endsAt     DateTime
  status     ClassStatus    @default(SCHEDULED)
  meetingUrl String?
  createdAt  DateTime       @default(now())

  // ── Lifecycle timestamps (Scheduled → Reminder → Teacher/Student Joined →
  //    In Progress → Completed → Attendance Locked) ──
  reminder24hSentAt DateTime?
  reminder1hSentAt  DateTime?
  reminder15mSentAt DateTime?
  teacherJoinedAt   DateTime?
  actualStartAt     DateTime?
  actualEndAt       DateTime?
  meetingId         String?
  sessionId         String?

  // Teacher attendance for this session
  teacherStatus      TeacherAttendanceStatus?
  teacherLateMinutes Int?

  // Locking (no edits once locked, unless an approved correction)
  attendanceLocked Boolean   @default(false)
  lockedAt         DateTime?
  // Set when the billing cycle this class belonged to is closed. A locked class
  // is a past cycle's and can no longer be rescheduled (distinct from
  // attendanceLocked, which finalises one class's attendance after it ends).
  cycleLocked Boolean @default(false)

  attendees   ClassAttendee[]
  corrections AttendanceCorrection[]

  @@index([startsAt])
  @@index([teacherId, startsAt])
  @@index([batchId, startsAt])
  @@index([status])
}

model ClassAttendee {
  id        String         @id @default(uuid())
  classId   String
  class     ClassSession   @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Kept for backward-compat; `status` is the source of truth going forward.
  attended  Boolean        @default(false)

  // Join / leave tracking
  joinedAt     DateTime?
  leftAt       DateTime?
  durationMins Int?
  device       String?
  browser      String?
  ipAddress    String?

  // Computed / verified attendance
  status      StudentAttendanceStatus?
  lateMinutes Int?
  remarks     String?

  @@unique([classId, studentId])
  @@index([studentId])
}

// A teacher's request to move one class of one student, awaiting academic-coach
// approval. Plain-id soft FKs (like the rest of the scheduling code) so no back
// relations are added to ClassSession/TeacherProfile/StudentProfile. Old/new
// times are snapshotted so the audited before→after stays readable even if the
// class is later moved again.
model ClassRescheduleRequest {
  id             String                @id @default(uuid())
  classSessionId String
  studentId      String
  teacherId      String // TeacherProfile id
  requestedById  String // the teacher's User id
  oldStartsAt    DateTime
  oldEndsAt      DateTime
  newStartsAt    DateTime
  newEndsAt      DateTime
  reason         String?
  status         ClassRescheduleStatus @default(PENDING)
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNotes    String?
  appliedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status])
  @@index([studentId, status])
  @@index([teacherId, studentId])
  @@index([classSessionId])
}

// ─── Batches (a scheduled cohort of a course, with one teacher + N students) ───
model Batch {
  id        String      @id @default(uuid())
  code      String      @unique // BATCH-0001
  name      String
  courseId  String
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  level     String?
  status    BatchStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?

  // Default weekly schedule (used to bulk-generate class sessions)
  daysOfWeek String[] @default([]) // ["Monday","Wednesday"]
  startTime  String?              // "09:00"
  endTime    String?              // "10:00"
  timeZone   String?
  capacity   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students BatchStudent[]
  classes  ClassSession[]
  assignments Assignment[]
  assessments Assessment[]

  @@index([courseId])
  @@index([teacherId])
  @@index([status])
}

model BatchStudent {
  id        String         @id @default(uuid())
  batchId   String
  batch     Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  addedAt   DateTime       @default(now())

  @@unique([batchId, studentId])
  @@index([studentId])
}

// A teacher-raised request to fix a locked/computed attendance value. Admin
// reviews; the row itself is the immutable audit line (who/what/when/outcome).
model AttendanceCorrection {
  id         String       @id @default(uuid())
  classId    String
  class      ClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  targetType String       // STUDENT / TEACHER
  studentId  String?      // StudentProfile id when targetType = STUDENT
  attendeeId String?      // ClassAttendee id when targetType = STUDENT

  fromStatus String?
  toStatus   String
  reason     String

  requestedById   String  // requesting user (teacher) id
  requestedByName String?
  status          CorrectionStatus @default(PENDING)
  reviewedById    String?
  reviewedByName  String?
  reviewNotes     String?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([status])
}

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueAt       DateTime?
  createdAt   DateTime @default(now())

  // ── Advanced Assignment Management ──
  batchId       String?
  batch         Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  teacherId     String?
  teacher       TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdById   String?         // User id of the author (admin/teacher)
  subject       String?
  chapter       String?
  topic         String?
  skillId       String?         // ProgressSkill link (feeds skill mastery %)
  difficulty    String?         // EASY / MEDIUM / HARD
  type          String?         // HOMEWORK / WORKSHEET / ESSAY / PROJECT / MCQ / CODING / ...
  instructions  String?
  maxMarks      Int             @default(100)
  passingMarks  Int             @default(40)
  lateAllowed   Boolean         @default(true)
  latePenaltyPct Int            @default(0)
  publishAt     DateTime?       // for SCHEDULED assignments
  status        String          @default("DRAFT") // DRAFT/SCHEDULED/PUBLISHED/CLOSED/ARCHIVED
  locked        Boolean         @default(false)
  targetType    String          @default("BATCH") // BATCH / SELECTED
  targetStudentIds String[]     @default([])
  allowedFileTypes String[]     @default([]) // e.g. ["pdf","docx"] — empty = any
  maxFileSizeMb Int?            // per-file ceiling shown to students
  attachments   Json?           // [{ url, name }]
  rubric        Json?           // [{ name, max }]
  updatedAt     DateTime        @updatedAt

  submissions Submission[]

  @@index([status])
  @@index([teacherId])
  @@index([batchId])
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       SubmissionStatus @default(ASSIGNED)
  content      String?
  fileUrl      String?
  attachments  Json?            // [{ url, name }]
  isLate       Boolean          @default(false)
  penaltyApplied Int?           // percentage points deducted
  grade        Int?
  rubricScores Json?            // { rubricName: score }
  feedback     String?
  feedbackFileUrl String?       // voice/video/attachment feedback
  similarityPct Int?            // plagiarism: % word-overlap with peers
  returnedReason String?
  draftSavedAt DateTime?
  submittedAt  DateTime?
  evaluatedAt  DateTime?

  @@unique([assignmentId, studentId])
  @@index([status])
}

// ─── Assessments (online tests: Question Bank → Assessment → Attempt → Result) ─

// Reusable Question Bank entry. Objective types (MCQ/TRUE_FALSE/FILL_BLANK/MATCH)
// are auto-graded; subjective types (SHORT/LONG/ESSAY/CODING/AUDIO/SPEAKING/
// FILE_UPLOAD) are teacher-graded against `rubric`.
model Question {
  id            String   @id @default(uuid())
  subject       String
  chapter       String?
  topic         String?
  category      String?
  difficulty    String   @default("MEDIUM") // EASY / MEDIUM / HARD
  type          String   // MCQ / TRUE_FALSE / FILL_BLANK / MATCH / SHORT_ANSWER / LONG_ANSWER / ESSAY / CODING / AUDIO / SPEAKING / FILE_UPLOAD
  text          String
  options       Json?    // MCQ: [{ id, text, correct }]; MATCH: [{ left, right }]
  correctAnswer String?  // TRUE_FALSE / FILL_BLANK canonical answer
  marks         Int      @default(1)
  negativeMarks Float    @default(0)
  estimatedTime Int      @default(60) // seconds
  explanation   String?
  media         Json?    // [{ url, name, kind }]
  rubric        Json?    // subjective grading: [{ name, max }]
  language      String?  // CODING: default language (javascript/python/...)
  testCases     Json?    // CODING: [{ input, expected, sample }]
  createdById   String?
  version       Int      @default(1)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assessmentQuestions AssessmentQuestion[]
  answers             AssessmentAnswer[]

  @@index([subject])
  @@index([type])
  @@index([difficulty])
  @@index([archived])
}

model Assessment {
  id            String          @id @default(uuid())
  title         String
  courseId      String?
  course        Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batchId       String?
  batch         Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  teacherId     String?
  teacher       TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdById   String?
  subject       String?
  chapter       String?
  topic         String?
  category      String?
  skillId       String?         // ProgressSkill link (feeds skill mastery %)
  type          String          @default("QUIZ") // QUIZ/WEEKLY_TEST/MONTHLY_TEST/UNIT_TEST/MID_TERM/FINAL_EXAM/ORAL_TEST/PRACTICE_TEST/MOCK_TEST
  instructions  String?

  // Rules
  durationMin           Int     @default(60)
  totalMarks            Int     @default(100)
  passingMarks          Int     @default(40)
  attemptsAllowed       Int     @default(1) // 0 = unlimited
  questionOrder         String  @default("FIXED") // FIXED / RANDOM
  allowBack             Boolean @default(true)
  showResultImmediately Boolean @default(false)
  negativeMarking       Boolean @default(false)

  // Question selection
  selectionMode String   @default("MANUAL") // MANUAL / RANDOM
  randomRules   Json?    // { subject, easy, medium, hard }

  // Scheduling window
  startAt   DateTime?
  endAt     DateTime?
  publishAt DateTime?
  status    String   @default("DRAFT") // DRAFT/SCHEDULED/PUBLISHED/LIVE/CLOSED/ARCHIVED
  locked    Boolean  @default(false)

  // Targeting
  targetType       String   @default("BATCH") // BATCH / SELECTED
  targetStudentIds String[] @default([])

  // Certificate
  certificateEnabled   Boolean @default(false)
  certificateThreshold Int     @default(70)

  // Proctoring (client-side tab-switch / copy detection)
  proctored Boolean @default(false)

  attachments Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([status])
  @@index([teacherId])
  @@index([batchId])
  @@index([courseId])
}

// Ordered link between an Assessment and a bank Question (with optional per-
// assessment marks override).
model AssessmentQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order        Int        @default(0)
  marks        Int?       // overrides Question.marks for this assessment

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

// A single student sitting of an assessment. Objective marks land in autoScore
// on submit; subjective marks accumulate in manualScore during teacher review.
model AssessmentAttempt {
  id           String         @id @default(uuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNo    Int            @default(1)
  status       String         @default("IN_PROGRESS") // IN_PROGRESS/SUBMITTED/UNDER_EVALUATION/EVALUATED/PUBLISHED

  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  evaluatedAt   DateTime?
  publishedAt   DateTime?
  autoSubmitted Boolean   @default(false)
  timeSpentSec  Int?

  autoScore    Float   @default(0) // objective portion
  manualScore  Float   @default(0) // subjective portion
  score        Float   @default(0) // total after negative marking
  totalMarks   Int     @default(0)
  percentage   Float   @default(0)
  passed       Boolean @default(false)
  rank         Int?
  correctCount Int     @default(0)
  wrongCount   Int     @default(0)
  skippedCount Int     @default(0)

  teacherFeedback String?
  certificateUrl  String?
  certificateNo   String? // issued certificate number (set when eligible + published)

  // Proctoring
  violations Int   @default(0)
  proctorLog Json? // [{ type, at }]

  answers AssessmentAnswer[]

  @@unique([assessmentId, studentId, attemptNo])
  @@index([assessmentId])
  @@index([studentId])
  @@index([status])
}

model AssessmentAnswer {
  id              String            @id @default(uuid())
  attemptId       String
  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response        Json?             // selected option ids / text / fileUrl
  markedForReview Boolean           @default(false)
  isCorrect       Boolean?          // null until graded (subjective)
  awardedMarks    Float?
  maxMarks        Int               @default(1)
  rubricScores    Json?             // { rubricName: score }
  feedback        String?
  autoGraded      Boolean           @default(false)
  timeSpentSec    Int?

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Invoice {
  id        String          @id @default(uuid())
  number    String          @unique
  // Optional: an invoice can bill a registered student OR a custom/external
  // recipient (whose name + email live in the notes payload).
  studentId String?
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  amount    Decimal         @db.Decimal(10, 2)
  currency  String          @default("USD")
  status    InvoiceStatus   @default(DRAFT)
  issuedAt  DateTime        @default(now())
  dueAt     DateTime?
  paidAt    DateTime?
  notes     String?

  // ── Finance & Reporting: fee-plan billing + partial payment tracking ──
  feePlanId     String?   // FeePlan this invoice was generated from (plain id)
  assignmentId  String?   // StudentFeeAssignment that generated a recurring invoice
  subscriptionId String?  // StudentSubscription this invoice bills (enrol + 28-day renewal), plain id
  periodLabel   String?   // "March 2026" for recurring invoices
  periodStart   DateTime?
  periodEnd     DateTime?
  subtotal      Decimal?  @db.Decimal(10, 2) // sum of items before discount + tax
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal   @default(0) @db.Decimal(10, 2)
  paidAmount    Decimal   @default(0) @db.Decimal(10, 2) // running total (partial payments)
  discountId    String?   // applied Discount (plain id)
  scholarshipId String?   // applied Scholarship (plain id)

  payments Payment[]
  items    InvoiceItem[]
  receipts Receipt[]
  refunds  Refund[]

  @@index([status])
  @@index([studentId])
  @@index([assignmentId])
  @@index([subscriptionId])
}

// A single fee line on an invoice (Course Fee, Admission Fee, ...).
model InvoiceItem {
  id        String           @id @default(uuid())
  invoiceId String
  invoice   Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      FeeComponentType @default(OTHER)
  label     String
  amount    Decimal          @db.Decimal(10, 2)

  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(uuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(10, 2)
  provider    String        @default("stripe")
  providerRef String?
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  // ── Finance & Reporting: payment method + receipt link ──
  method       String?  // UPI / BANK_TRANSFER / CARD / RAZORPAY / STRIPE / CASH
  reference    String?  // txn reference the admin records
  receivedById String?  // staff user id who recorded the payment
  notes        String?
  receipt      Receipt?

  @@index([invoiceId])
  @@index([status])
}

/*
 * Every Stripe webhook we have already handled.
 *
 * Stripe redelivers: on a timeout, a non-2xx, or a retry from its dashboard the
 * same event arrives again, and two deliveries of one payment_intent.succeeded
 * would record the payment twice. The event id is the natural key, so the
 * insert itself is the lock — a duplicate hits the unique constraint and is
 * answered 200 without touching the invoice.
 *
 * Failures are kept too, with the error, so a payment that Stripe believes it
 * delivered can be found rather than guessed at.
 */
model StripeWebhookEvent {
  id          String   @id // Stripe's own event id (evt_...)
  type        String
  payload     Json
  handled     Boolean  @default(false)
  error       String?
  invoiceId   String?
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@index([type])
  @@index([handled])
}

// A payment receipt (first-class, numbered, e-mailable/downloadable).
model Receipt {
  id        String   @id @default(uuid())
  number    String   @unique // RCPT-2026-000001
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  studentId String?
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("USD")
  method    String?
  notes     String?
  issuedAt  DateTime @default(now())

  @@index([invoiceId])
  @@index([studentId])
}

model SystemSetting {
  key   String @id
  value String
}

enum CandidateStatus {
  NEW
  SHORTLISTED
  REJECTED
  WAITING
  APPROVED
}

model Candidate {
