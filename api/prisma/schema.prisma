// ─── Trial Classes ────────────────────────────────────────────────────────────

enum TrialStatus {
  PENDING
  SCHEDULED
  COMPLETED
}

model TrialClass {
  id                 String      @id @default(uuid())
  name               String
  email              String
  mobile             String
  country            String
  course             String
  prefTeacherGender  String      // "Male", "Female", "Any"
  status             TrialStatus @default(PENDING)
  age                Int
  goals              String?
  scheduledTime      String?     // Date or text string
  assignedTeacher    String?
  meetLink           String?
  pronunciationGrade String?
  fluencyGrade       String?
  focusGrade         String?
  recommendedLevel   String?
  evaluationNotes    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // "COURSE", "ASSIGNMENT", "ASSESSMENT", "KNOWLEDGEBASE"
  createdAt DateTime @default(now())

  @@unique([name, type])
}

model LmsCourse {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  category      String
  level         String
  studentsCount Int      @default(0)
  teachersCount Int      @default(0)
  status        String   @default("Active")
  createdAt     String
  description   String

  /*
   * What a student actually enrols in.
   *
   * This catalogue and the relational `Course` grew up apart: an admin created
   * a course here and it appeared on the courses page and nowhere else — no
   * enrolment, no batch, no attendance, no subscription could point at it,
   * because all of those reference `Course`. LmsPackage has mirrored into
   * `Package` for a while; courses never did.
   *
   * These two fields are what `Course` needs and this row did not carry.
   * Nullable because the rows existed before the columns did.
   */
  price         Float?
  durationWeeks Int?
}

model LmsAssignment {
  id               String   @id @default(uuid())
  title            String
  courseCode       String
  courseTitle      String
  category         String
  studentsCount    Int      @default(0)
  submissionsCount Int      @default(0)
  evaluatedCount   Int      @default(0)
  dueDate          String
  status           String   @default("Active")
  description      String
}

model LmsAssessment {
  id             String   @id @default(uuid())
  title          String
  courseCode     String
  courseTitle    String
  questionsCount Int
  duration       Int
  category       String
  avgScore       Float    @default(0)
  status         String   @default("Active")
  description    String
}

model LmsKnowledgebase {
  id          String   @id @default(uuid())
  title       String
  courseCode  String
  courseTitle String
  format      String
  sizeMB      Float
  category    String
  downloads   Int      @default(0)
  status      String   @default("Active")
  description String
  // Points at the stored file (relative path under /uploads) for uploaded
  // resources, or an external URL for "Link" resources. Null until a file is
  // attached. fileName keeps the original name for the download prompt.
  fileUrl     String?
  fileName    String?
}

model LmsPackage {
  id          String   @id @default(uuid())
  title       String
  // Mirrors Package's three amounts — see the note there for why these are
  // entered rather than converted.
  priceUSD    Float
  priceAED    Float?
  priceGBP    Float?
  billing     String
  level       String
  courses     String[]
  features    String[]
  status      String   @default("Active")
  description String

  /*
   * How many classes a month this package buys. Nullable only because the
   * column arrived after the rows did; every code path treats a missing value
   * as "not set yet" rather than substituting one.
   *
   * This used to be inferred from the marketing copy by regex, with a silent
   * default of 8 — a number that reaches a student's screen, decides the
   * "hours difference" a coach approves, and travels with the billing. A
   * feature line mentioning any number between 4 and 30 could set it.
   */
  classesPerMonth Int?

  /*
   * Which fee plan bills this package, mirrored onto the relational `Package`
   * where the approval screen reads it. Held as a plain id rather than a
   * relation: this catalogue is flat by design, and the enforced link lives on
   * `Package.feePlanId`.
   */
  feePlanId String?

  /*
   * Subscription-model attributes, mirrored onto the relational `Package` (which
   * the enrolment/billing side reads). Flat plain ids/scalars by design — the
   * enforced relations live on `Package`. See the note on `Package` for what
   * each field means. All nullable so legacy rows keep working untouched.
   */
  modelId           String?
  tier              String?
  durationMinutes   Int?
  weeklyClasses     Int?
  monthlyHours      Int?
  hourlyRateUSD     Float?
  hourlyRateAED     Float?
  hourlyRateGBP     Float?
  rescheduleLimit   Int?     @default(0)
  familyDiscountPct Float?   @default(0)
  featureMatrix     Json?
  eSyllabus         Boolean? @default(false)
  displayOrder      Int?     @default(0)
  badge             String?
}

model LmsClass {
  id          String   @id @default(uuid())
